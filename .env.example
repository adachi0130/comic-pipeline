# 环境变量示例 —— 复制为 .env（项目根）后按需修改；.env 已 .gitignore，不会提交。
#
# 全部可选：不填就用 app/config.py 里的默认值。
# 前缀固定为 COMIC_；嵌套字段用双下划线（__）分隔，例如 COMIC_TUNNEL__SSH_HOST。

# ---- 数据落盘 ----
# COMIC_DATA_DIR=./data
# COMIC_DB_URL=sqlite:///./data/comic.db

# ---- 出图后端（ComfyUI）----
# COMIC_COMFY_BASE_URL=http://127.0.0.1:18188
# COMIC_COMFY_LOCAL_FALLBACK_URL=http://127.0.0.1:8188
# COMIC_COMFY_TIMEOUT_S=30
# COMIC_COMFY_MAX_CONCURRENCY=2

# ---- 仙宫云/云端 ComfyUI 的 SSH 隧道（把远端 8188 映射到本机）----
# COMIC_TUNNEL__ENABLED=true
# COMIC_TUNNEL__SSH_HOST=your.ssh.host
# COMIC_TUNNEL__SSH_PORT=22
# COMIC_TUNNEL__SSH_USER=root
# COMIC_TUNNEL__SSH_KEY_PATH=C:/Users/you/.ssh/id_rsa
# COMIC_TUNNEL__REMOTE_PORT=8188
# COMIC_TUNNEL__LOCAL_PORT=18188

# ---- 业务默认值 ----
# COMIC_DEFAULT_REVIEW_MODE=manual        # manual=到审查门停住 / auto=全自动
# COMIC_DEFAULT_TARGET_PAGES=16
# COMIC_DEFAULT_CANDIDATES_PER_PANEL=4

# ---- 酒馆数据目录（留空则自动探测，用于「从酒馆导入模型配置」）----
# COMIC_TAVERN_DATA_DIR=E:/path/to/SillyTavern/data/default-user
